# ============================================
# POWERHAUS ACADEMY - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)
# ============================================

# SUPABASE DATABASE (REQUIRED)
# Get this from: Supabase Dashboard → Settings → Database → Connection String (URI)
# Replace [YOUR-PASSWORD] with your actual database password
DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# Example with actual format:
# DATABASE_URL=postgresql://postgres.abcdefgh:mySecretPass123@db.aedmsxvhvroqvkobjkgr.supabase.co:5432/postgres

# SESSION SECRET (REQUIRED)
# Any random string (32+ characters recommended)
SESSION_SECRET=powerhaus_academy_session_secret_change_this_to_random_string

# STRIPE PAYMENTS (OPTIONAL - for payment features)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
